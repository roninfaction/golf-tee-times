# Copy this to .env.local for local dev, or set these in Cloudflare Pages dashboard.
# For staging, create a separate Supabase project and use its credentials here.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# App
NEXT_PUBLIC_APP_URL=https://golfpack.app
NEXT_PUBLIC_EMAIL_FORWARD_DOMAIN=golfpack.app

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:noreply@golfpack.app

# OneSignal (optional — legacy push fallback)
NEXT_PUBLIC_ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_key

# External APIs
OPENAI_API_KEY=your_openai_key
GOOGLE_PLACES_API_KEY=your_google_places_key
RESEND_API_KEY=your_resend_key
RESEND_INBOUND_SIGNING_SECRET=your_webhook_secret

# Cron auth
CRON_SECRET=your_cron_secret

# Error monitoring
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn

# GHIN API (Phase 2)
# GHIN_API_KEY=your_ghin_api_key
